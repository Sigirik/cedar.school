# ---------- Postgres (dev) ----------
POSTGRES_DB=cedar_dev
POSTGRES_USER=cedar_dev
POSTGRES_PASSWORD=CHANGE_ME

# ---------- Django (dev) ----------
DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=dev-secret-change-me-please
DEBUG=true

# API dev домен
ALLOWED_HOSTS=api.dev.cedar.school,127.0.0.1,localhost

# Разрешённый фронт для CORS/CSRF (если включишь front-dev)
CORS_ALLOWED_ORIGINS=https://dev.cedar.school
CSRF_TRUSTED_ORIGINS=https://dev.cedar.school

# Подключение к БД (имя хоста = имя контейнера)
DATABASE_URL=postgres://cedar_dev:CHANGE_ME@pg-dev:5432/cedar_dev

# Локаль/логи/пути