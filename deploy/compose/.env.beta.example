 ---------- Postgres (beta) ----------
POSTGRES_DB=cedar_beta
POSTGRES_USER=cedar_beta
POSTGRES_PASSWORD=CHANGE_ME

# ---------- Django (beta) ----------
DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=CHANGE_ME
DEBUG=false

# Важно: на сервере это доменное имя API-beta
ALLOWED_HOSTS=api.beta.cedar.school,beta.cedar.school,127.0.0.1,localhost

# Разрешённый фронт для CORS
CORS_ALLOWED_ORIGINS=https://beta.cedar.school
CSRF_TRUSTED_ORIGINS=https://beta.cedar.school

# Подключение к БД (имя хоста = имя контейнера)
DATABASE_URL=postgres://cedar_beta:CHANGE_ME@pg-beta:5432/cedar_beta

TIME_ZONE=Europe/Moscow
STATIC_ROOT=/app/staticfiles
TIME_ZONE=Europe/Helsinki
LOG_LEVEL=INFO

STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

AUTH_DEBUG=1

